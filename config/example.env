# Copy to .env and source before launching, or export these in your shell.
# Paths must point at your own Isaac Sim install and WebRTC client.

# Root of this helper repo (auto-detected by scripts if unset)
# ISAAC_TCP_ROOT=/path/to/isaac-sim-tcp-only-cloud

# Isaac Sim standalone install (must contain isaac-sim.streaming.sh)
ISAAC_ROOT=/path/to/Isaac

# Extracted Isaac Sim WebRTC Streaming Client directory
# (the folder that contains the isaacsim-webrtc-streaming-client binary)
CLIENT_DIR=/path/to/Isaac Sim WebRTC Streaming Client

# Built NVENC interposer (see nvenc/README.md)
NVENC_FIX=/path/to/isaac-sim-tcp-only-cloud/nvenc/libnvenc_fix.so

# Optional: directory with real libnvidia-ngx / OptiX bits if the image ships stubs
# NGX_LIB_DIR=/path/to/nvidia-libs

# Vulkan ICD for headless EGL (create or point at your nvidia_icd.json)
# VK_ICD_FILENAMES=/path/to/vulkan/nvidia_icd.json

# Extra libs for the Electron WebRTC client (e.g. libasound)
# CLIENT_LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu

LOG_DIR=/tmp/isaac-tcp-only-logs
WEB_PORT=6006
VNC_PORT=5900
DISPLAY_NUM=1
RES=1920x1080
SIGNAL_PORT=49100
STREAM_PORT=47998

# ICE address the *local* WebRTC client can reach (container eth0 / bridge IP).
# Not your public HTTPS proxy URL. Leave empty to auto-detect via hostname -I.
# HOST_IP=172.17.0.2

# Optional Isaac CLI extras (scene load, etc.)
# ISAAC_EXTRA_ARGS=
